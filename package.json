{
  "name": "vite-plugin-file-router",
  "version": "2.0.1",
  "description": "Vite plugin: scan pages/ to generate routes.ts or routes.js for React Router / Vue Router. TypeScript and JavaScript projects supported; hand-edits preserved on regen.",
  "keywords": [
    "vite",
    "vite-plugin",
    "file-based-routing",
    "react-router",
    "vue-router",
    "capacitor",
    "spa"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:react": "vite --config demo/react/vite.config.ts --port 5199 --strictPort",
    "demo:react-js": "vite --config demo/react-js/vite.config.js --port 5201 --strictPort",
    "demo:vue": "vite --config demo/vue/vite.config.ts --port 5200 --strictPort",
    "test:compat": "node compat/run.mjs",
    "verify": "pnpm test && pnpm build && pnpm test:compat && pnpm pack:check"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "esbuild": "^0.27.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4"
  }
}
